{
  "name": "mouse-following-square-lens-effect",
  "type": "module",
  "version": "0.0.1",
  "description": "An interactive pointer-following square lens distortion with a radial RGB shift, built with Three.js and GLSL.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier \"src/**/*.{astro,html,scss}\" --write",
    "format:check": "prettier \"src/**/*.{astro,html,scss}\" --check",
    "lint:styles": "stylelint \"src/styles/**/*.scss\" \"src/**/*.astro\"",
    "lint:styles:fix": "stylelint \"src/styles/**/*.scss\" \"src/**/*.astro\" --fix",
    "lint:scripts": "eslint \"src/**/*.astro\" \"src/scripts/**/*.ts\"",
    "lint:scripts:fix": "eslint \"src/**/*.astro\" \"src/scripts/**/*.ts\" --fix"
  },
  "dependencies": {
    "astro": "^6.4.2",
    "lil-gui": "^0.21.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.184.1",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.100.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite-plugin-glsl": "^1.6.0"
  }
}
